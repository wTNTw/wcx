<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifest overlay for the Zygisk payload only.

  The payload is loaded by the Zygisk loader, never by an Xposed framework, so
  it must not advertise itself as an Xposed module or install the LSPosed
  settings shortcut. Ordinary standard/legacy builds do not use this file.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <meta-data
            android:name="xposedmodule"
            tools:node="remove" />
        <meta-data
            android:name="xposeddescription"
            tools:node="remove" />
        <meta-data
            android:name="xposedminversion"
            tools:node="remove" />
        <meta-data
            android:name="xposedscope"
            tools:node="remove" />
        <meta-data
            android:name="xposedsharedprefs"
            tools:node="remove" />

        <activity android:name=".activity.MainActivity">
            <intent-filter>
                <category
                    android:name="de.robv.android.xposed.category.MODULE_SETTINGS"
                    tools:node="remove" />
            </intent-filter>
        </activity>
    </application>
</manifest>
